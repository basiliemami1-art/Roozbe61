<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Subscription aggregators are frequently mirrored over plain HTTP, and the
      loopback endpoints used to probe the local cores are HTTP by definition.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
